<Window x:Class="ALambdaTTS.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置"
        Width="470"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource Background}"
        FontFamily="{StaticResource BodyFont}"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">
    <StackPanel Margin="22,18,22,16">

        <TextBlock Text="外观" FontSize="12" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextMuted}" Margin="0,0,0,8" />
        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
            <ToggleButton x:Name="ThemeAuto" Style="{StaticResource ChipToggle}" Content="跟随系统"
                          Height="30" Padding="14,0" Margin="0,0,6,0" Click="ThemeChip_Click" Tag="auto" />
            <ToggleButton x:Name="ThemeLight" Style="{StaticResource ChipToggle}" Content="浅色"
                          Height="30" Padding="14,0" Margin="0,0,6,0" Click="ThemeChip_Click" Tag="light" />
            <ToggleButton x:Name="ThemeDark" Style="{StaticResource ChipToggle}" Content="深色"
                          Height="30" Padding="14,0" Click="ThemeChip_Click" Tag="dark" />
        </StackPanel>
        <TextBlock Text="强调色固定为绿松石 #20808D，深浅两套色板各自微调亮度。"
                   FontSize="11" Foreground="{DynamicResource TextFaint}" Margin="0,4,0,18" />

        <TextBlock Text="下载文件夹" FontSize="12" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextMuted}" Margin="0,0,0,8" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{DynamicResource SurfaceAlt}"
                    BorderBrush="{DynamicResource Border}" BorderThickness="1">
                <TextBox x:Name="DownloadBox" Style="{StaticResource FlatTextBox}" Height="30"
                         Margin="9,0" TextChanged="DownloadBox_TextChanged" />
            </Border>
            <Button Grid.Column="1" Style="{StaticResource GhostButton}" Content="浏览…"
                    Margin="6,0,0,0" Height="30" Padding="10,0" Click="Browse_Click" />
            <Button Grid.Column="2" Style="{StaticResource GhostButton}" Content="默认"
                    Margin="4,0,0,0" Height="30" Padding="10,0" Click="ResetFolder_Click"
                    ToolTip="恢复为 音乐\ATTS" />
        </Grid>
        <TextBlock Text="点“下载”才会把 mp3 保存到这里；卡片缓存只在本次运行有效，关闭程序即清空。"
                   FontSize="11" Foreground="{DynamicResource TextFaint}" TextWrapping="Wrap"
                   Margin="0,8,0,16" />

        <TextBlock Text="关于" FontSize="12" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextMuted}" Margin="0,0,0,8" />
        <TextBlock x:Name="AboutText" FontSize="11.5" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextMuted}" LineHeight="19" />

        <Button Style="{StaticResource GhostButton}" Content="关闭" HorizontalAlignment="Right"
                Margin="0,18,0,0" Height="30" Padding="18,0" Click="Close_Click" />
    </StackPanel>
</Window>
