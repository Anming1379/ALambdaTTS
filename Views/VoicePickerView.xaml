<UserControl x:Class="ALambdaTTS.Views.VoicePickerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:themes="clr-namespace:ALambdaTTS.Themes"
             Width="440"
             PreviewKeyDown="Root_PreviewKeyDown">
    <Border Background="{DynamicResource Surface}"
            BorderBrush="{DynamicResource BorderStrong}"
            BorderThickness="1">
        <Grid Margin="0,10,0,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 搜索 -->
            <Border Grid.Row="0" Margin="12,0,12,8" Background="{DynamicResource SurfaceAlt}"
                    BorderBrush="{DynamicResource Border}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{x:Static themes:IconGlyphs.Search}" Style="{StaticResource IconText}" FontSize="16"
                               Foreground="{DynamicResource TextMuted}" Margin="8,0,4,0" />
                    <TextBox x:Name="SearchBox" Grid.Column="1" Style="{StaticResource FlatTextBox}"
                             Height="28" Margin="0,0,8,0" Foreground="{DynamicResource Text}"
                             TextChanged="SearchBox_TextChanged" />
                    <TextBlock x:Name="SearchPlaceholder" Grid.Column="1" Text="搜索音色名 / 语言"
                               IsHitTestVisible="False" VerticalAlignment="Center" Margin="1,0,0,0"
                               FontSize="12.5" Foreground="{DynamicResource TextFaint}" />
                </Grid>
            </Border>

            <!-- 性别筛选 -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="12,0,12,6">
                <TextBlock Text="性别" FontSize="11.5" Foreground="{DynamicResource TextMuted}"
                           VerticalAlignment="Center" Margin="0,0,8,0" />
                <ToggleButton x:Name="GenderAll" Style="{StaticResource ChipToggle}" Content="全部"
                              IsChecked="True" Margin="0,0,4,0" Click="GenderChip_Click" Tag="all" />
                <ToggleButton x:Name="GenderFemale" Style="{StaticResource ChipToggle}" Content="女声"
                              Margin="0,0,4,0" Click="GenderChip_Click" Tag="female" />
                <ToggleButton x:Name="GenderMale" Style="{StaticResource ChipToggle}" Content="男声"
                              Click="GenderChip_Click" Tag="male" />
            </StackPanel>

            <!-- 语言筛选 -->
            <Grid Grid.Row="2" Margin="12,0,12,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="语言" FontSize="11.5" Foreground="{DynamicResource TextMuted}"
                           VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox x:Name="LanguageCombo" Grid.Column="1" Style="{StaticResource FlatComboBox}"
                          ItemContainerStyle="{StaticResource FlatComboBoxItem}"
                          SelectionChanged="LanguageCombo_SelectionChanged">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Label}" FontSize="12"
                                       Foreground="{DynamicResource Text}"
                                       TextTrimming="CharacterEllipsis" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </Grid>

            <!-- 音色列表 -->
            <Border Grid.Row="3" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0">
                <ListBox x:Name="VoiceList" Background="Transparent" BorderThickness="0"
                         MaxHeight="300" Margin="0,4,0,0"
                         ItemContainerStyle="{StaticResource VoiceListItem}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         SelectionChanged="VoiceList_SelectionChanged"
                         PreviewMouseUp="VoiceList_PreviewMouseUp">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding DisplayName}" FontSize="13"
                                               Foreground="{DynamicResource Text}"
                                               TextTrimming="CharacterEllipsis" />
                                    <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                                        <TextBlock Text="{Binding LocaleLabel}" FontSize="10.5"
                                                   Foreground="{DynamicResource TextMuted}" />
                                        <TextBlock Text="  ·  " FontSize="10.5"
                                                   Foreground="{DynamicResource TextFaint}" />
                                        <TextBlock Text="{Binding GenderLabel}" FontSize="10.5"
                                                   Foreground="{DynamicResource TextMuted}" />
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding CategoryLabel}" FontSize="10"
                                           Foreground="{DynamicResource Accent}" VerticalAlignment="Center"
                                           MaxWidth="140" TextTrimming="CharacterEllipsis" Margin="8,0,0,0" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <TextBlock x:Name="EmptyHint" Grid.Row="3" Text="没有匹配的音色"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       FontSize="12" Foreground="{DynamicResource TextFaint}"
                       Visibility="Collapsed" />

            <TextBlock x:Name="CountText" Grid.Row="4" Margin="12,8,12,0" FontSize="10.5"
                       Foreground="{DynamicResource TextFaint}" />
        </Grid>
    </Border>
</UserControl>
