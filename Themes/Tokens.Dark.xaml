<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 深色色板。强调色在深底上提亮一档，保证对比度；半透明层级同样保留。 -->
    <SolidColorBrush x:Key="Background" Color="#15191A" />
    <SolidColorBrush x:Key="Surface" Color="#1B2122" />
    <SolidColorBrush x:Key="SurfaceAlt" Color="#232A2B" />
    <SolidColorBrush x:Key="SurfaceHover" Color="#2B3334" />
    <SolidColorBrush x:Key="Border" Color="#2C3435" />
    <SolidColorBrush x:Key="BorderStrong" Color="#3F4A4B" />
    <SolidColorBrush x:Key="Text" Color="#E7EBEB" />
    <SolidColorBrush x:Key="TextMuted" Color="#94A0A0" />
    <SolidColorBrush x:Key="TextFaint" Color="#6C7777" />

    <SolidColorBrush x:Key="Accent" Color="#2AA0B0" />
    <SolidColorBrush x:Key="AccentHover" Color="#35B0C1" />
    <SolidColorBrush x:Key="AccentPressed" Color="#1F8B99" />
    <SolidColorBrush x:Key="AccentSoft" Color="#292AA0B0" />
    <SolidColorBrush x:Key="AccentFaint" Color="#142AA0B0" />
    <SolidColorBrush x:Key="AccentBorder" Color="#552AA0B0" />
    <SolidColorBrush x:Key="OnAccent" Color="#08211F" />

    <SolidColorBrush x:Key="Danger" Color="#E17C72" />
    <SolidColorBrush x:Key="DangerSoft" Color="#26E17C72" />

    <SolidColorBrush x:Key="TrackBrush" Color="#2C3435" />
    <SolidColorBrush x:Key="ScrollThumb" Color="#3A4445" />
    <SolidColorBrush x:Key="ScrollThumbHover" Color="#4C5859" />
    <SolidColorBrush x:Key="Shadow" Color="#55000000" />

</ResourceDictionary>
