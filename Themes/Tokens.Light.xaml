<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 浅色色板。强调色为真·绿松石 #20808D，按不同 alpha 分出层级，
         所有界面颜色都从这里取，控件里一律用 DynamicResource。 -->
    <SolidColorBrush x:Key="Background" Color="#F5F6F6" />
    <SolidColorBrush x:Key="Surface" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SurfaceAlt" Color="#EDF0F0" />
    <SolidColorBrush x:Key="SurfaceHover" Color="#E8ECEC" />
    <SolidColorBrush x:Key="Border" Color="#E1E5E5" />
    <SolidColorBrush x:Key="BorderStrong" Color="#C9D1D1" />
    <SolidColorBrush x:Key="Text" Color="#1E2425" />
    <SolidColorBrush x:Key="TextMuted" Color="#6E7878" />
    <SolidColorBrush x:Key="TextFaint" Color="#9AA3A3" />

    <!-- 强调色：实色 / 悬浮 / 按下 / 半透明层级 / 反白文字 -->
    <SolidColorBrush x:Key="Accent" Color="#20808D" />
    <SolidColorBrush x:Key="AccentHover" Color="#1C7480" />
    <SolidColorBrush x:Key="AccentPressed" Color="#16606B" />
    <SolidColorBrush x:Key="AccentSoft" Color="#1F20808D" />
    <SolidColorBrush x:Key="AccentFaint" Color="#0F20808D" />
    <SolidColorBrush x:Key="AccentBorder" Color="#4A20808D" />
    <SolidColorBrush x:Key="OnAccent" Color="#FFFFFF" />

    <SolidColorBrush x:Key="Danger" Color="#B4433A" />
    <SolidColorBrush x:Key="DangerSoft" Color="#1FB4433A" />

    <SolidColorBrush x:Key="TrackBrush" Color="#E1E5E5" />
    <SolidColorBrush x:Key="ScrollThumb" Color="#CDD5D5" />
    <SolidColorBrush x:Key="ScrollThumbHover" Color="#B2BDBD" />
    <SolidColorBrush x:Key="Shadow" Color="#22000000" />

</ResourceDictionary>
