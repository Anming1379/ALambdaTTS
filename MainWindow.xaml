<Window x:Class="ALambdaTTS.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ALambdaTTS.Controls"
        xmlns:models="clr-namespace:ALambdaTTS.Models"
        xmlns:utils="clr-namespace:ALambdaTTS.Utils"
        xmlns:views="clr-namespace:ALambdaTTS.Views"
        xmlns:themes="clr-namespace:ALambdaTTS.Themes"
        Title="ALambda TTS"
        Width="600" Height="760"
        MinWidth="540" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Background}"
        FontFamily="{StaticResource BodyFont}"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        AllowDrop="True"
        DragOver="Window_DragOver"
        Drop="Window_Drop"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <utils:KnobValueConverter x:Key="KnobValueConverter" />
        <utils:ResourceBrushConverter x:Key="ResourceBrushConverter" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- 工具栏高度写死 55（54 内容 + 1 底线）：叠层面板不能把它撑高 -->
            <RowDefinition Height="55" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============ 工具栏 ============ -->
        <Border Grid.Row="0" Background="{DynamicResource Surface}"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
            <Grid Height="54" Margin="8,0,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 音色选择 -->
                <Button x:Name="VoiceButton" Grid.Column="0" Style="{StaticResource GhostButton}"
                        Padding="8,4" Click="VoiceButton_Click" ToolTip="选择音色">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{x:Static themes:IconGlyphs.RecordVoiceOver}" Style="{StaticResource IconText}" FontSize="18"
                                   Foreground="{DynamicResource Accent}" Margin="0,0,7,0" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="VoiceNameText" Text="加载音色…" FontSize="12.5"
                                       Foreground="{DynamicResource Text}" MaxWidth="140"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="VoiceMetaText" Text="正在获取音色列表" FontSize="10"
                                       Foreground="{DynamicResource TextMuted}" MaxWidth="140"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <TextBlock Text="{x:Static themes:IconGlyphs.ExpandMore}" Style="{StaticResource IconText}" FontSize="15"
                                   Foreground="{DynamicResource TextFaint}" Margin="5,0,0,0" />
                    </StackPanel>
                </Button>

                <!-- 语速 / 音量 -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,0,12,0" VerticalAlignment="Center"
                                ToolTip="语速：鼠标上划变大，双击复位">
                        <controls:Knob x:Name="RateKnob" Width="26" Height="26"
                                       Minimum="-50" Maximum="100" CenterValue="0"
                                       Step="5" ResetValue="0" Value="0" />
                        <StackPanel VerticalAlignment="Center" Margin="6,0,0,0">
                            <TextBlock Text="语速" FontSize="9.5" Foreground="{DynamicResource TextMuted}" />
                            <TextBlock FontSize="11.5" Foreground="{DynamicResource Accent}"
                                       Width="40" TextAlignment="Left"
                                       Text="{Binding Value, ElementName=RateKnob,
                                              Converter={StaticResource KnobValueConverter},
                                              ConverterParameter=rate}" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,12,0" VerticalAlignment="Center"
                                ToolTip="语调：鼠标上划变高，双击复位">
                        <controls:Knob x:Name="PitchKnob" Width="26" Height="26"
                                       Minimum="-50" Maximum="50" CenterValue="0"
                                       Step="5" ResetValue="0" Value="0" />
                        <StackPanel VerticalAlignment="Center" Margin="6,0,0,0">
                            <TextBlock Text="语调" FontSize="9.5" Foreground="{DynamicResource TextMuted}" />
                            <TextBlock FontSize="11.5" Foreground="{DynamicResource Accent}"
                                       Width="40" TextAlignment="Left"
                                       Text="{Binding Value, ElementName=PitchKnob,
                                              Converter={StaticResource KnobValueConverter},
                                              ConverterParameter=pitch}" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                ToolTip="音量：鼠标上划变大，双击复位">
                        <controls:Knob x:Name="VolumeKnob" Width="26" Height="26"
                                       Minimum="0" Maximum="100" Step="5" ResetValue="100" Value="100" />
                        <StackPanel VerticalAlignment="Center" Margin="6,0,0,0">
                            <TextBlock Text="音量" FontSize="9.5" Foreground="{DynamicResource TextMuted}" />
                            <TextBlock FontSize="11.5" Foreground="{DynamicResource Accent}"
                                       Width="40" TextAlignment="Left"
                                       Text="{Binding Value, ElementName=VolumeKnob,
                                              Converter={StaticResource KnobValueConverter},
                                              ConverterParameter=volume}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <Border Grid.Column="2" Width="1" Height="24" Background="{DynamicResource Border}"
                        Margin="10,0" />

                <Button Grid.Column="3" Style="{StaticResource IconButton}" Click="Settings_Click"
                        ToolTip="设置" VerticalAlignment="Center">
                    <TextBlock Text="{x:Static themes:IconGlyphs.Settings}" Style="{StaticResource IconText}" FontSize="20" />
                </Button>
            </Grid>
        </Border>

        <!-- ============ 历史卡片 ============ -->
        <Grid Grid.Row="1">
            <ListBox x:Name="HistoryList" Background="Transparent" BorderThickness="0"
                     Margin="10,10,4,0" Padding="0"
                     Focusable="False"
                     SelectionMode="Single"
                     ItemContainerStyle="{StaticResource HistoryListItem}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:TtsItem}">
                        <Border Background="{DynamicResource Surface}"
                                BorderBrush="{DynamicResource Border}" BorderThickness="1"
                                Padding="12,10,7,9">
                            <Border.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="复制原文" Click="CardCopy_Click" />
                                    <MenuItem Header="删除这张卡片" Click="CardDelete_Click" />
                                </ContextMenu>
                            </Border.ContextMenu>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Preview}" TextWrapping="Wrap"
                                               MaxHeight="63" TextTrimming="CharacterEllipsis"
                                               FontSize="13" LineHeight="19"
                                               Foreground="{DynamicResource Text}" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                VerticalAlignment="Center" Margin="6,0,0,0">
                                        <Button Style="{StaticResource IconButton}" Click="CardPlay_Click"
                                                ToolTip="播放 / 暂停" IsEnabled="{Binding CanPlay}">
                                            <TextBlock Text="{Binding PlayIcon}" Style="{StaticResource IconText}"
                                                       FontSize="21" Foreground="{DynamicResource Accent}" />
                                        </Button>
                                        <Button Style="{StaticResource IconButton}" Click="CardDownload_Click"
                                                ToolTip="保存到下载文件夹" IsEnabled="{Binding CanPlay}">
                                            <TextBlock Text="{x:Static themes:IconGlyphs.Download}" Style="{StaticResource IconText}"
                                                       FontSize="19" />
                                        </Button>
                                        <Button Style="{StaticResource IconButton}" Click="CardRetry_Click"
                                                ToolTip="重新合成这一次请求"
                                                Visibility="{Binding CanRetry, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="{x:Static themes:IconGlyphs.Refresh}" Style="{StaticResource IconText}"
                                                       FontSize="19" Foreground="{DynamicResource Danger}" />
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Grid.Row="1" Text="{Binding MetaText}" Margin="0,7,4,0" FontSize="10.5"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{Binding MetaBrushKey, Converter={StaticResource ResourceBrushConverter}}" />

                                <StackPanel Grid.Row="2" Margin="0,5,4,0">
                                    <ProgressBar Style="{StaticResource MicroProgress}" Maximum="1"
                                                 Value="{Binding Progress}"
                                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                                    <TextBlock Text="{Binding StatusLabel}" FontSize="10.5" Margin="0,4,0,0"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{Binding MetaBrushKey, Converter={StaticResource ResourceBrushConverter}}"
                                               Visibility="{Binding ShowStatus, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- 空状态 -->
            <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center"
                        IsHitTestVisible="False">
                <TextBlock Text="{x:Static themes:IconGlyphs.GraphicEq}" Style="{StaticResource IconText}" FontSize="40"
                           Foreground="{DynamicResource AccentBorder}" />
                <TextBlock Text="输入文字后按 Enter 生成语音" FontSize="12.5" Margin="0,12,0,0"
                           Foreground="{DynamicResource TextFaint}" HorizontalAlignment="Center" />
                <TextBlock Text="生成记录只保留在本次运行中，记得点下载保存" FontSize="11" Margin="0,5,0,0"
                           Foreground="{DynamicResource TextFaint}" HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- ============ 输入区 ============ -->
        <Border Grid.Row="2" x:Name="ComposerPanel" Height="98"
                Background="{DynamicResource Surface}"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0">
            <Grid Margin="14,10,11,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <TextBox x:Name="InputBox" Style="{StaticResource ComposerTextBox}"
                             TextChanged="InputBox_TextChanged"
                             GotKeyboardFocus="InputBox_GotKeyboardFocus"
                             LostKeyboardFocus="InputBox_LostKeyboardFocus"
                             PreviewKeyDown="InputBox_PreviewKeyDown" />
                    <TextBlock x:Name="InputPlaceholder"
                               Text="输入要朗读的文字，Enter 生成，Shift + Enter 换行，也可以粘贴或拖入 .txt"
                               IsHitTestVisible="False" TextWrapping="Wrap"
                               FontSize="13.5" Foreground="{DynamicResource TextFaint}"
                               Margin="0,1,0,0" />
                </Grid>

                <Button x:Name="SendButton" Grid.Column="1" Style="{StaticResource AccentButton}"
                        VerticalAlignment="Bottom" Margin="10,0,0,0"
                        Click="SendButton_Click" ToolTip="生成语音（Enter）">
                    <TextBlock x:Name="SendIcon" Text="{x:Static themes:IconGlyphs.ArrowUpward}" Style="{StaticResource IconText}"
                               FontSize="20" Foreground="{DynamicResource OnAccent}" />
                </Button>
            </Grid>
        </Border>

        <!-- ============ 状态栏 ============ -->
        <Border Grid.Row="3" Height="26" Background="{DynamicResource Background}"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0">
            <Grid Margin="14,0,8,0">
                <TextBlock x:Name="StatusText" Text="就绪" FontSize="11"
                           Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" Margin="0,0,140,0" />

                <Button x:Name="DownloadFolderButton" HorizontalAlignment="Right"
                        Style="{StaticResource GhostButton}" Padding="6,1" Focusable="False"
                        Click="OpenDownloadFolder_Click" ToolTip="打开下载文件夹">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{x:Static themes:IconGlyphs.FolderOpen}" Style="{StaticResource IconText}" FontSize="14"
                                   Foreground="{DynamicResource Accent}" />
                        <TextBlock x:Name="DownloadFolderText" FontSize="10.5" Margin="5,0,0,0"
                                   Foreground="{DynamicResource TextMuted}" MaxWidth="250"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- 音色面板：窗口内叠层。比 Popup 可靠：命中测试、键盘焦点都正常 -->
        <Grid x:Name="VoiceOverlay" Grid.Row="0" Grid.RowSpan="4"
              Visibility="Collapsed" Panel.ZIndex="20">
            <Border Background="#01000000" MouseDown="VoiceOverlay_Dismiss" />
            <Border x:Name="VoicePanel"
                    HorizontalAlignment="Left" VerticalAlignment="Top"
                    Margin="8,56,0,0" Width="440" MaxHeight="470"
                    Background="Transparent" ClipToBounds="True">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.20" />
                </Border.Effect>
                <views:VoicePickerView x:Name="VoicePicker" />
            </Border>
        </Grid>
    </Grid>
</Window>
